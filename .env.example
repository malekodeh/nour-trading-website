# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://nourtrading.com

# ---- Form delivery (configure at least one, or forms will report "not configured") ----
# Email notifications via Resend (https://resend.com). Sender domain must be verified in Resend.
RESEND_API_KEY=
QUOTE_NOTIFY_TO=nourtradingusa@gmail.com
QUOTE_NOTIFY_FROM=Nour Trading Website <website@nourtrading.com>   # nourtrading.com must be verified in Resend

# Airtable CRM (https://airtable.com/create/tokens) — token needs data.records:write on the base
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_QUOTES_TABLE=Quote Requests
AIRTABLE_CONTACTS_TABLE=Contact Messages

# Optional: Cloudflare Turnstile spam protection (leave blank to rely on honeypot + rate limit)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
